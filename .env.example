DATABASE_URI=postgres://postgres:postgres@localhost:5433/catalogo
PAYLOAD_SECRET=troque-por-uma-string-longa-e-aleatoria
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Em produção (Vercel) a DATABASE_URI precisa ser o pooler de transação, na
# porta 6543. O host direto do Supabase só resolve IPv6, que a Vercel não
# alcança, e o modo session estoura em 15 conexões:
# DATABASE_URI=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# Storage das imagens. Sem estas variáveis o Payload grava em `media/`, que é o
# certo no local. Na Vercel o disco é efêmero e elas passam a ser obrigatórias:
# as credenciais S3 saem do painel do Supabase, em Storage > S3 Connection.
# S3_BUCKET=media
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
